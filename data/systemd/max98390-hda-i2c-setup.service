[Unit]
Description=Create I2C devices for MAX98390 HDA speaker amplifiers
ConditionPathExistsGlob=/sys/bus/acpi/devices/M*X98390:*
Wants=akmods.service
After=akmods.service systemd-modules-load.service
Before=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/galaxybook-max98390/max98390-hda-i2c-setup.sh start
ExecStop=/usr/libexec/galaxybook-max98390/max98390-hda-i2c-setup.sh stop
TimeoutStartSec=30s

[Install]
WantedBy=sound.target
